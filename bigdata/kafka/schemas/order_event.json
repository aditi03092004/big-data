{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderEvent",
  "type": "object",
  "properties": {
    "eventType": {
      "type": "string",
      "enum": ["ORDER_CREATED", "ORDER_UPDATED"]
    },
    "orderId": { "type": "string" },
    "customerId": { "type": "string" },
    "productId": { "type": "string" },
    "product": { "type": "string" },
    "amount": { "type": "number" },
    "location": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "required": ["eventType", "orderId", "customerId", "productId", "amount", "location", "timestamp"]
}
